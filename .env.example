# WhyViral — API keys & scraper config
# ── Core (Gemini is always required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Scraper provider (open-source default)
# SCRAPER_PROVIDER=crawlee  → open-source, local, $0/run, anti-ban hardened (RECOMMENDED)
# SCRAPER_PROVIDER=auto     → try Crawlee first, fallback to Apify if blocked (default)
# SCRAPER_PROVIDER=apify    → hosted Apify actors only (needs APIFY_TOKEN)
SCRAPER_PROVIDER=auto
APIFY_TOKEN=

# ── Crawlee anti-ban settings (only when SCRAPER_PROVIDER is crawlee/auto)
# How to stay unbanned: keep defaults — they are conservative by design.
# CRAWLEE_MAX_CONCURRENCY=1    # 1 = stealthiest; raise to 2–3 only with proxy
# CRAWLEE_PROXY=               # http://user:pass@host:port  (residential/datacenter proxy — use for high volume)
# CRAWLEE_HEADLESS=true        # true = headless browser in fallback path
# CRAWLEE_WITH_BROWSER=true    # set false to disable Playwright entirely (TikWM/fetch only — safest)
# CRAWLEE_PLAYWRIGHT_FALLBACK=true  # true = browser fallback when fetch empty (auto-fallback to Apify still safe)
# CRAWLEE_STEALTH=true         # true = hide AutomationControlled (needs playwright stealth args)
# CRAWLEE_VERBOSE=false        # true = extra crawl logs

# ── All-platform keys (all optional with Crawlee — each has a safe public fallback)
# YOUTUBE_API_KEY=            # YouTube Data API v3 key for Shorts (highest quota, zero ban risk); fallback uses ytInitialData scraping
# LINKEDIN_COOKIE=            # li_at cookie for LinkedIn authenticated search (optional; without it LinkedIn returns empty gracefully)
# For X/Twitter, Pinterest, Reddit, Snapchat: no keys needed — guest-token / JSON / HTML public endpoints are used.
